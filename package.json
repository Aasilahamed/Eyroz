{
  "name": "eyroz",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop companion for verified Codex session status.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && node scripts/run-electron.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.app.json && vite build && npm run build:electron",
    "start": "node scripts/run-electron.mjs",
    "test": "tsx --test src/status/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
